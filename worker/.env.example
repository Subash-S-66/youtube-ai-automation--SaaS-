# Worker runtime environment

# Prebuilt worker image reference used by worker/docker-compose.yml.
# Do not use :latest. Always pin a specific tag (date/build/commit).
# Example: ghcr.io/your-org/clipforge-worker:20260406-1200
WORKER_IMAGE=clipforge-worker:queue-worker-v1

# Core shared infra
MONGO_URI=
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=8000
REDIS_COMMAND_TIMEOUT_MS=15000
REDIS_MAX_RETRY_DELAY_MS=2000
REDIS_COMMAND_TIMEOUT_LOG_THROTTLE_MS=30000
BACKEND_URL=
WEBHOOK_SECRET=
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Runner selection controls (defaults are now admin-managed via SystemConfig)
PIPELINE_RUNNER=local
PIPELINE_RUNNER_PINNED=true
PIPELINE_SERVICE_URL=
PIPELINE_SERVICE_SECRET=

# Worker runtime fallback defaults
PIPELINE_WORKER_PROFILE=local
PIPELINE_WORKER_CONCURRENCY=
PIPELINE_WORKER_HEARTBEAT_MS=10000
PIPELINE_HEARTBEAT_RUNNER_CACHE_MS=30000

# AI + content generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
JULES_API_URL=
JULES_API_KEY=

# OAuth for YouTube upload refresh
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure runner (required when using azure runner)
AZURE_JOB_NAME=
AZURE_JOB_CONTAINER_NAME=
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_ARM_API_VERSION=2023-05-01

# Optional safety/performance tuning
EMERGENCY_STOP=false
GEMINI_TIMEOUT_MS=15000
SUBTOPIC_GEN_TIMEOUT_MS=3000
QUEUE_DISPATCH_TIMEOUT_MS=5000
PIPELINE_ENQUEUE_REQUEST_TIMEOUT_MS=15000
CHANNEL_UPLOAD_WINDOW_CHECK_TIMEOUT_MS=1500
PIPELINE_RETRY_CONFIG_TIMEOUT_MS=1500
MAX_CONCURRENT_PIPELINES_PER_USER=10

# Optional callback target (leave empty for fully backend-free runs)
WEBHOOK_URL=
