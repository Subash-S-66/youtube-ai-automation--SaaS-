MONGO_URI=
JWT_SECRET=
# Include protocol and no leading/trailing spaces, for example: https://clipforgeapp.tech
FRONTEND_URL=
# Include protocol and no leading/trailing spaces, for example: https://api.clipforgeapp.tech
BACKEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match Google OAuth redirect URI for app login callback.
GOOGLE_REDIRECT_URI=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must resolve to https://<api-domain>/api/youtube/callback (no query/hash).
YOUTUBE_REDIRECT_URI=
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_AMOUNT_PAISE=
RAZORPAY_CURRENCY=INR
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=8000
# Increase if your host has occasional Redis latency spikes.
REDIS_COMMAND_TIMEOUT_MS=15000
REDIS_MAX_RETRY_DELAY_MS=2000
# Throttle repeated command-timeout warning logs.
REDIS_COMMAND_TIMEOUT_LOG_THROTTLE_MS=30000
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=
WEBHOOK_SECRET=
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Pipeline runner configuration
# Runtime controls can now be managed from Admin Panel (SystemConfig).
# Env values below are fallback defaults used before config is loaded.
PIPELINE_RUNNER=local
# When true, worker always uses PIPELINE_RUNNER and ignores admin-configured primary runner.
PIPELINE_RUNNER_PINNED=false
PIPELINE_SERVICE_URL=
PIPELINE_SERVICE_SECRET=
# Set true to always run pipeline worker in the API process.
# If false, a dedicated worker process must be running, otherwise jobs may stay queued.
RUN_EMBEDDED_WORKER=false
# When enabled, API auto-starts embedded worker if no dedicated worker heartbeat is detected.
AUTO_START_EMBEDDED_WORKER_WHEN_MISSING=false
# When true, runtime status cards include embedded API workers as connected workers.
# Keep false in production when API should stay "brain only" and workers run on laptop/VM/Azure.
INCLUDE_EMBEDDED_WORKERS_IN_RUNTIME_STATUS=false
# Dedicated/embedded worker heartbeat interval used for liveness detection.
PIPELINE_WORKER_HEARTBEAT_MS=10000
# Worker profile controls default concurrency when PIPELINE_WORKER_CONCURRENCY is not set:
# local = single worker (best for laptop), vm = CPU-based medium parallelism, cloud = higher parallelism.
PIPELINE_WORKER_PROFILE=local
# Optional explicit concurrency override for dedicated worker process.
PIPELINE_WORKER_CONCURRENCY=
EMERGENCY_STOP=false

# Optional performance tuning
GEMINI_TIMEOUT_MS=15000
SUBTOPIC_GEN_TIMEOUT_MS=3000
QUEUE_DISPATCH_TIMEOUT_MS=5000
PIPELINE_ENQUEUE_REQUEST_TIMEOUT_MS=15000
CHANNEL_UPLOAD_WINDOW_CHECK_TIMEOUT_MS=1500
PIPELINE_RETRY_CONFIG_TIMEOUT_MS=1500
MAX_CONCURRENT_PIPELINES_PER_USER=10
# Hard timeout (seconds) for each ffmpeg/ffprobe command executed by pipeline rendering.
FFMPEG_COMMAND_TIMEOUT_SECONDS=360
# Composition stage heartbeat log interval (seconds) while render is running.
COMPOSITION_HEARTBEAT_SECONDS=30

# Azure runner configuration (required when PIPELINE_RUNNER=azure)
# These values must exist in the process that runs pipelineWorker (embedded or dedicated worker).
AZURE_JOB_NAME=
AZURE_JOB_CONTAINER_NAME=
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Set true only for local development when Azure env vars are intentionally absent.
ALLOW_AZURE_SIMULATION=false
# Must be a plain date value like 2023-05-01 (do not use text such as "use 2023-05-01")
AZURE_ARM_API_VERSION=2023-05-01
