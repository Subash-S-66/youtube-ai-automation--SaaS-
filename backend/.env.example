MONGO_URI=
JWT_SECRET=
# Include protocol and no leading/trailing spaces, for example: https://clipforgeapp.tech
FRONTEND_URL=
# Include protocol and no leading/trailing spaces, for example: https://api.clipforgeapp.tech
BACKEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match Google OAuth redirect URI for app login callback.
GOOGLE_REDIRECT_URI=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must resolve to https://<api-domain>/api/youtube/callback (no query/hash).
YOUTUBE_REDIRECT_URI=
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_AMOUNT_PAISE=
RAZORPAY_CURRENCY=INR
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=8000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_MAX_RETRY_DELAY_MS=2000
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=
WEBHOOK_SECRET=
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Pipeline runner configuration
PIPELINE_RUNNER=local
PIPELINE_SERVICE_URL=
PIPELINE_SERVICE_SECRET=
RUN_EMBEDDED_WORKER=false
EMERGENCY_STOP=false

# Optional performance tuning
GEMINI_TIMEOUT_MS=15000
SUBTOPIC_GEN_TIMEOUT_MS=3000
QUEUE_DISPATCH_TIMEOUT_MS=5000
PIPELINE_ENQUEUE_REQUEST_TIMEOUT_MS=15000
MAX_CONCURRENT_PIPELINES_PER_USER=10

# Azure runner configuration (required when PIPELINE_RUNNER=azure)
AZURE_JOB_NAME=
AZURE_JOB_CONTAINER_NAME=
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Must be a plain date value like 2023-05-01 (do not use text such as "use 2023-05-01")
AZURE_ARM_API_VERSION=2023-05-01
